# Copy this file to .env and adjust. Never commit the real .env.
# Values already set in the real environment always win over this file.

NODE_ENV=development
PORT=5000

# REQUIRED IN PRODUCTION. The server refuses to start with the default value
# when NODE_ENV=production. Generate one with:  npm run secret
JWT_SECRET=zetu-studio-secret-key-change-in-production

# How long a sign-in lasts (30m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Where the SQLite file lives. Defaults to ./data/zetu.db
# DB_PATH=./data/zetu.db

# Allowed browser origins. "*" allows any (development default).
# In production leave unset for same-origin only, or list them comma-separated.
# CORS_ORIGIN=https://booking.zetustudio.com

# Public URL of the app. Used for the "Open the calendar" link in emails.
# APP_URL=https://booking.zetustudio.com


# ── Super admin ──────────────────────────────────────────────────────────────
# The studio's own account. Outranks admin: it can promote and demote admins,
# and cannot be demoted or deleted by anyone.
SUPER_ADMIN_EMAIL=zetustudios@shopzetu.com
SUPER_ADMIN_NAME=Zetu Studios

# Set this BEFORE the first start to choose the password. Leave it blank and a
# strong one is generated and printed once in the server log.
# SUPER_ADMIN_PASSWORD=


# ── Studio admin (the original demo account) ─────────────────────────────────
ADMIN_EMAIL=admin@zetustudio.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Studio Admin


# ── Email notifications ──────────────────────────────────────────────────────
# Notifications are skipped, with a log line, until SMTP_HOST, SMTP_USER and
# SMTP_PASS are all set. Everything else keeps working without them.
#
# Google Workspace / Gmail (recommended for this setup):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=zetustudios@shopzetu.com
#   SMTP_PASS=<16-character App Password — NOT the account password>
#   App Passwords require 2-Step Verification on the account:
#   https://myaccount.google.com/apppasswords
#
# Other providers:
#   Outlook 365   smtp.office365.com : 587
#   SendGrid      smtp.sendgrid.net  : 587   user "apikey", pass = the API key
#   Mailgun       smtp.mailgun.org   : 587
#   Resend        smtp.resend.com    : 587   user "resend",  pass = the API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false          # true for port 465; inferred from the port otherwise

# Where notifications go. Defaults to SUPER_ADMIN_EMAIL.
# NOTIFY_EMAIL=zetustudios@shopzetu.com
MAIL_FROM_NAME=Zetu Studio Bookings
# MAIL_FROM=                 # defaults to SMTP_USER; most providers reject others

# Which events send mail
NOTIFY_ON_BOOKING=true
NOTIFY_ON_CANCEL=true

# Daily schedule digest, in the server's local time
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIME=07:00


# bcrypt work factor. Higher is slower and safer.
BCRYPT_ROUNDS=10
